  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
      PERIODO_CONTABLE
      ,RAMO_PROD
      ,POLIZA
      ,TIPO_IDENTIFI_TOM
      ,NRO_IDENTIFI_TOM
      ,sum(VR_PRIMA_PESOS_COA) as PRIMA_EMITIDA
      COD_MODALIDAD
	  , case 
	  when COD_MODALIDAD=3 then 'PAZ Y SALVO'
	  when COD_MODALIDAD=5 then 'PROGRAMA FUTURO PROTEGIDO-PAP'
	  when COD_MODALIDAD=6 then 'FUTURO PROTEGIDO PLUS'
	  when COD_MODALIDAD=8 then 'SEGURO FUNERARIO'
	  else 'Sin Modalidad'
	  end as Desc_Modalidad
  FROM Liberty.PROD.DWH_POLIZAS_H t1
  where PERIODO_CONTABLE =@periodo_contable  and sucursal_prod=197 
  GROUP BY 
       PERIODO_CONTABLE
      ,RAMO_PROD
      ,POLIZA
      ,TIPO_IDENTIFI_TOM
      ,NRO_IDENTIFI_TOM
      ,COD_MODALIDAD</CommandText>
      </Query>
    </DataSet>
    <DataSet Name="periodos">
      <Query>
        <DataSourceName>DataSource2</DataSourceName>
        <CommandText>SELECT distinct
      PERIODO_CONTABLE
     FROM Liberty.PROD.[DWH_POLIZAS_H t1
  where PERIODO_CONTABLE BETWEEN 202201 AND 203001 order by PERIODO_CONTABLE</CommandText>
      </Query>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource3</DataSourceName>
        <CommandText>SELECT 
      PERIODO_CONTABLE
      ,sum(VR_PRIMA_PESOS_COA) as PRIMA_EMITIDA
	  , case 
	  when COD_MODALIDAD=3 then 'PAZ Y SALVO'
	  when COD_MODALIDAD=5 then 'PROGRAMA FUTURO PROTEGIDO-PAP'
	  when COD_MODALIDAD=6 then 'FUTURO PROTEGIDO PLUS'
	  when COD_MODALIDAD=8 then 'SEGURO FUNERARIO'
	  else 'Sin Modalidad'
	  end as Desc_Modalidad
  FROM Liberty.PROD.DWH_POLIZAS_H t1
  where ANNO_CONTABLE = @ANNO and sucursal_prod=197
  GROUP BY 
       PERIODO_CONTABLE
      ,COD_MODALIDAD</CommandText>
      </Query>
    </DataSet>
    <DataSet Name="ANNO">
      <Query>
        <DataSourceName>DataSource4</DataSourceName>
        <CommandText>  SELECT distinct
      ANNO_CONTABLE
  FROM Liberty.PROD.DWH_POLIZAS_H t1
  where PERIODO_CONTABLE BETWEEN 202201 AND 203001 order by ANNO_CONTABLE</CommandText>
      </Query>
    </DataSet>
  </DataSets>
