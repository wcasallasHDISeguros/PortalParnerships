    <DataSet Name="SBU">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select DISTINCT ltrim(rtrim(SBU)) as SBU  from liberty.APOYO.DWH_SBU_RAMO_PROD
WHERE SBU &lt;&gt;' '</CommandText>
      </Query>
      <Fields>
        <Field Name="SBU">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>SBU</DataField>
