    <DataSet Name="Intermediarios">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select cod_intermediario from liberty.apoyo.dwh_intermediarios_total 
order by cod_intermediario </CommandText>
      </Query>
      <Fields>
        <Field Name="cod_intermediario">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>cod_intermediario</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Ramo">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>="select DISTINCT RAMO_PROD from liberty.APOYO.DWH_SBU_RAMO_PROD WHERE SBU IN ('" &amp; Join(Parameters!SBU.Value, "','") &amp; "') AND RAMO_PROD NOT IN ('5','6','7','8','9','13','14','17','23','24','25','27','500','551','640','641','659','670','680','681','683','700','7401','7402','7403','7404','7405', '7406','7407','7408','7409','7410','7411','7412','7413','7414','7415','7416','7417','7418','7419','7420','7421','7422','7423','7424','7425','7426', '7427','7428','7429','7430','7431','7432','7433','7434','7435','7436','7437','7438','7439','7440','7441','7442','7443','7444','7445','7446','7447', '7448','760','761','763','780','790','791','800','810','812','820','860','880','881','900','901','920','923','992','A01','A02','A03','A08','A10', 'A11','A12','A16','A17','A18','B33','BC ','C65','EE ','EM ','GLO','HPL','I02','I03','I46','I47','I54','KA ','KB ','KC ','KD ','KE ','KH ','KI ', 'KM ','KP ','KR ','KT ','LI ','LR ','M42','M48','M51','MA ','MG ','MGE','MP ','NC ','NG ','P24','R15','R20','R52','RM ','T00','T01','T03','T07', 'T08','T31','T58','T71','T92','T93','T94','TB ','TC ','TD ','TE ','TG ','TI ','TL ','TM ','TN ','TR ','TV ','TY ','U04','U16','U19','U20','U21', 'U22','U24','U25','U28','U31','U33','U34','U36','U38','U39','U41','U42','U44','VD ')"</CommandText>
      </Query>
      <Fields>
        <Field Name="RAMO_PROD">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>RAMO_PROD</DataField>
        </Field>
      </Fields>
    </DataSet>
