  <DataSets>
    <DataSet Name="Liberty">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>="WITH asistencias_vigentes AS ( SELECT P.* FROM ( select M.*,ROW_NUMBER ()over (partition by M.LLAVE_CERT order by M.LLAVE_CERT, M.DOCUMENTO desc , M.anexo desc , M.recibo desc, M.SMOVREC desc ) as ult_doc from ( select distinct (TRIM(T1.RAMO_PROD) || '_' || POLIZA::VARCHAR || '_' || CERTIFICADO::VARCHAR || '_' || t1.amparo_orig::VARCHAR) AS LLAVE_CERT, (TRIM(T1.RAMO_PROD) || '_' || POLIZA::VARCHAR) AS LLAVE_POL,T1.RAMO_PROD,POLIZA,CERTIFICADO, t1.amparo_orig, case when t1.sis_origen = 'N' THEN T3.DESCRIPCION ELSE t4.descripcion END AS DESC_AMPARO, FI_CERTIFICADO, FF_CERTIFICADO, max(sucursal_prod) as sucursal_prod, max(COD_MODALIDAD) as COD_MODALIDAD, ltrim(rtrim(t2.SBU)) as SBU, documento, ANEXO, case when RECIBO is null then 0 else RECIBO end as RECIBO, case when SMOVREC is null then 0 else SMOVREC end as SMOVREC, tipo_transaccion, cod_transaccion from Liberty.prod.dwh_pol_amp_h t1 LEFT JOIN LIBERTY.APOYO.DWH_SBU_RAMO_PROD T2 ON (ltrim(rtrim(T1.RAMO_PROD))=ltrim(rtrim(T2.RAMO_PROD))) left join Liberty.APOYO.DWH_DESC_AMPARO t3 on (t1.amparo_orig=t3.AMPARO) left join liberty_pruebas_actuaria.dbo.AMPARO_ASISTENCIAS__OLDCORE t4 on (t1.ramo_prod=t4.ramo_prod and t1.amparo_orig=t4.amparo) where periodo_contable &gt; 202306 and FI_CERTIFICADO&lt;=TO_CHAR(CURRENT_DATE, 'YYYYMMDD')::INTEGER and FF_CERTIFICADO&gt;=TO_CHAR(CURRENT_DATE, 'YYYYMMDD')::INTEGER AND RTRIM(T1.RAMO_PROD) || '-' || t1.amparo_orig::VARCHAR IN ('410-16','410-19','411-11','462-41','462-42','463-19','720-09','6071-9697','6071-9696','6071-9695','6071-9698','6071-3006','6071-9694','6071-3010','10000-3010', '10000-3006','10001-3006','10001-3010','10003-3010','10003-9695','10003-9698','10003-9697','10003-9694','10003-3006','10003-9696','10024-3173','10024-8883','10024-8882','10024-3155','900742-3155','900742-3173', '900742-3179','900748-9813','900748-9814','900758-9695','900758-9698','900758-3006','900758-9696','900758-9697','900758-9694','LGP-299','TRM-942','Z2-77773','Z2-77771','Z1-965','Z1-900','Z1-897','Z1-891','Z1-889', 'Z1-77773','Z1-77771','Z1-220','Z1-215','Z1-214','WM-32','WM-24','WM-15','WM-13','WM-12','VP-11','U79-35','U76-15','U62-9','U44-37','U33-35','U33-32','U03-15','U03-13','U03-12','TY-Z3','TY-S1','TY-PR','TU-26', 'TU-24','TU-15','TU-13','TU-12','TT-48','TT-26','TT-24','TT-15','TT-13','TT-12','TS-26','TS-24','TS-13','TRM-995','TRM-896','TP-48','TP-26','TP-24','TP-15','TP-13','TP-12','TO-32','TO-26','TO-24','TO-15','TO-13', 'TO-12','TI-S1','TI-H4','TI-F8','TI-E8','TI-CC','T71-3010','T71-3006','T4-77773','T4-77771','T2-77773','T1-900','T1-77773','T1-220','T1-215','T1-214','T03-3010','T03-3006','T01-3010','T01-3006','T00-3010','T00-3006', 'SE-897','SE-891','SE-220','SE-215','SE-214','SA-215','PY-Z3','PY-W7','PY-S1','PY-PR','PYM-725','PYM-299','PY-725','PY-299','PO-35','PO-32','PO-26','PO-24','PO-15','PO-13','PO-12','PM-24','PM-15','PM-13','PM-12', 'PE-26','PE-24','PE-15','PE-13','PE-12','P24-3173','O10-220','O10-215','MW-48','MW-24','MW-15','MW-13','MW-12','MUF-97220','MUF-725','MUF-724','MUF-237','MUC-744','MUC-725','MUC-501','MUC-44','MUC-263','MUC-237', 'MUC-153','MU-26','MU-24','MU-15','MU-13','MU-12','MT-24','MT-15','MT-13','MT-12','MO-32','MO-24','MO-15','MO-13','MO-12','MF-15','MF-13','MF-12','ME-24','ME-15','ME-13','ME-12','MC-15','MC-13','MC-12','M42-3173', 'LPF-725','LPE-772','LPE-725','LPE-299','LPC-770','LPC-725','LPC-299','LO-35','LO-32','LO-26','LO-24','LO-15','LO-13','LO-12','LM-34','LM-26','LM-24','LM-15','LM-13','LM-12','LGS-772','LGS-725','LGS-299','LGP-725', 'LF-32','LF-26','LF-15','LF-13','LF-12','LD-11','LB-4','KP-Z3','KP-PR','KH-H4','IF-S1','IF-K8','IF-F8','IF-E8','IF-CX','IF-C8','IF-844','IF-843','IF-842','IF-841','IF-840','IF-839','IF-838','IF-837','IF-836','IF-835', 'IF-834','IF-833','HPL-725','HPL-724','HPL-237','H1-891','H1-889','H1-220','H1-215','H1-214','GN-187','GLO-97220','GLO-725','GLO-724','GLO-237','GC-187','F2-77773','F2-77771','F1-77773','F1-77771','ET-26','ET-24', 'ET-15','ET-13','ET-12','E1-891','E1-889','E1-220','E1-215','E1-214','DX-77773','D4-77773','CT-34','CT-26','CT-24','CT-15','CT-13','CT-12','CL-15','CL-13','CL-12','BO-14','BO-12','BC-Q8','BC-D1','BC-77773','B33-35', 'B33-32','B03-13','B03-12','AX-32','AX-26','AX-24','AX-15','AX-13','AX-12','AW-32','AW-26','AW-24','AW-15','AW-13','AW-12','AU-32','AU-26','AU-24','AU-15','AU-13','AU-12','AT-34','AT-32','AT-26','AT-24','AT-15', 'AT-13','AT-12','AL-32','AL-26','AL-24','AL-15','AL-13','AL-12','AI-400','AI-355','ADU-215','AC-77771','AC-400','A61-774','A61-768','A61-767','A61-766','A60-774','A60-768','A60-767','A60-766','A53-774','A53-769', 'A53-768','A53-767','A53-766','A49-767','A49-766','A48-768','A48-767','A48-766','A47-774','A47-768','A47-767','A47-766','A46-776','A46-774','A46-768','A46-767','A46-766','A45-802','A45-774','A45-769','A45-768', 'A45-767','A45-766','A43-768','A43-767','A43-766','A42-774','A42-769','A42-768','A42-767','A42-766','A41-774','A41-769','A41-768','A41-767','A41-766','A40-774','A40-769','A40-768','A40-767','A40-766','A39-774', 'A39-768','A39-767','A39-766','A38-774','A38-768','A38-767','A38-766','A37-774','A37-769','A37-768','A37-767','A37-766','A36-774','A36-768','A36-767','A36-766','A35-768','A35-767','A35-766','A34-768','A34-767', 'A34-766','A33-774','A33-769','A33-768','A33-767','A33-766','A32-774','A32-769','A32-768','A32-767','A32-766','A31-774','A31-769','A31-768','A31-767','A31-766','A06-13','A06-12','80-20936','79-20936','78-20936', '77-20936','720-9','59-20936','500-5','463-20','460-17','413-10','411-30','411-27','411-25','411-24','411-17','411-16','411-12','4-10413','4-10412','398-1','396-5','396-3','396-1','395-6','283-3','281-2','280-3', '23-725','164-12','164-11','163-15','163-12','163-11','162-16','162-12','162-11','120-15','120-12','120-11','10024-3179','900754-3006') AND T1.RAMO_PROD NOT IN ('70107','70108','8092','900731','900742','900745','900746') GROUP BY T1.RAMO_PROD,POLIZA,CERTIFICADO,t1.amparo_orig,t1.sis_origen,T3.DESCRIPCION,FI_CERTIFICADO,FF_CERTIFICADO, t2.SBU,documento,ANEXO,RECIBO,SMOVREC,tipo_transaccion,cod_transaccion,t4.descripcion UNION select distinct (TRIM(T1.RAMO_PROD) || '_' || POLIZA::VARCHAR || '_' || RIESGO::VARCHAR || '_' || t1.amparo::VARCHAR) AS LLAVE_CERT, (TRIM(T1.RAMO_PROD) || '_' || POLIZA::VARCHAR) AS LLAVE_POL,T1.RAMO_PROD,POLIZA,RIESGO as CERTIFICADO, t1.amparo, T3.DESCRIPCION AS DESC_AMPARO, FI_CERTIFICADO, FF_CERTIFICADO, max(sucursal_prod) as sucursal_prod, max(COD_MODALIDAD) as COD_MODALIDAD, ltrim(rtrim(t2.SBU)) as SBU, documento, ANEXO, case when RECIBO is null then 0 else RECIBO end as RECIBO, case when SMOVREC is null then 0 else SMOVREC end as SMOVREC, tipo_transaccion, cod_transaccion from Liberty.OTH.dwh_detalle_riesgos t1 LEFT JOIN LIBERTY.APOYO.DWH_SBU_RAMO_PROD T2 ON (ltrim(rtrim(T1.RAMO_PROD))=ltrim(rtrim(T2.RAMO_PROD))) left join Liberty.APOYO.DWH_DESC_AMPARO t3 on (t1.amparo=t3.AMPARO) where periodo_contable &gt; 202306 and FI_CERTIFICADO&lt;=TO_CHAR(CURRENT_DATE, 'YYYYMMDD')::INTEGER and FF_CERTIFICADO&gt;=TO_CHAR(CURRENT_DATE, 'YYYYMMDD')::INTEGER AND RTRIM(T1.RAMO_PROD) || '-' || t1.amparo::VARCHAR IN ('410-16','410-19','411-11','462-41','462-42','463-19','720-09','6071-9697','6071-9696','6071-9695','6071-9698','6071-3006','6071-9694','6071-3010','10000-3010', '10000-3006','10001-3006','10001-3010','10003-3010','10003-9695','10003-9698','10003-9697','10003-9694','10003-3006','10003-9696','10024-3173','10024-8883','10024-8882','10024-3155','900742-3155','900742-3173', '900742-3179','900748-9813','900748-9814','900758-9695','900758-9698','900758-3006','900758-9696','900758-9697','900758-9694','LGP-299','TRM-942','Z2-77773','Z2-77771','Z1-965','Z1-900','Z1-897','Z1-891','Z1-889', 'Z1-77773','Z1-77771','Z1-220','Z1-215','Z1-214','WM-32','WM-24','WM-15','WM-13','WM-12','VP-11','U79-35','U76-15','U62-9','U44-37','U33-35','U33-32','U03-15','U03-13','U03-12','TY-Z3','TY-S1','TY-PR','TU-26', 'TU-24','TU-15','TU-13','TU-12','TT-48','TT-26','TT-24','TT-15','TT-13','TT-12','TS-26','TS-24','TS-13','TRM-995','TRM-896','TP-48','TP-26','TP-24','TP-15','TP-13','TP-12','TO-32','TO-26','TO-24','TO-15','TO-13', 'TO-12','TI-S1','TI-H4','TI-F8','TI-E8','TI-CC','T71-3010','T71-3006','T4-77773','T4-77771','T2-77773','T1-900','T1-77773','T1-220','T1-215','T1-214','T03-3010','T03-3006','T01-3010','T01-3006','T00-3010','T00-3006', 'SE-897','SE-891','SE-220','SE-215','SE-214','SA-215','PY-Z3','PY-W7','PY-S1','PY-PR','PYM-725','PYM-299','PY-725','PY-299','PO-35','PO-32','PO-26','PO-24','PO-15','PO-13','PO-12','PM-24','PM-15','PM-13','PM-12', 'PE-26','PE-24','PE-15','PE-13','PE-12','P24-3173','O10-220','O10-215','MW-48','MW-24','MW-15','MW-13','MW-12','MUF-97220','MUF-725','MUF-724','MUF-237','MUC-744','MUC-725','MUC-501','MUC-44','MUC-263','MUC-237', 'MUC-153','MU-26','MU-24','MU-15','MU-13','MU-12','MT-24','MT-15','MT-13','MT-12','MO-32','MO-24','MO-15','MO-13','MO-12','MF-15','MF-13','MF-12','ME-24','ME-15','ME-13','ME-12','MC-15','MC-13','MC-12','M42-3173', 'LPF-725','LPE-772','LPE-725','LPE-299','LPC-770','LPC-725','LPC-299','LO-35','LO-32','LO-26','LO-24','LO-15','LO-13','LO-12','LM-34','LM-26','LM-24','LM-15','LM-13','LM-12','LGS-772','LGS-725','LGS-299','LGP-725', 'LF-32','LF-26','LF-15','LF-13','LF-12','LD-11','LB-4','KP-Z3','KP-PR','KH-H4','IF-S1','IF-K8','IF-F8','IF-E8','IF-CX','IF-C8','IF-844','IF-843','IF-842','IF-841','IF-840','IF-839','IF-838','IF-837','IF-836','IF-835', 'IF-834','IF-833','HPL-725','HPL-724','HPL-237','H1-891','H1-889','H1-220','H1-215','H1-214','GN-187','GLO-97220','GLO-725','GLO-724','GLO-237','GC-187','F2-77773','F2-77771','F1-77773','F1-77771','ET-26','ET-24', 'ET-15','ET-13','ET-12','E1-891','E1-889','E1-220','E1-215','E1-214','DX-77773','D4-77773','CT-34','CT-26','CT-24','CT-15','CT-13','CT-12','CL-15','CL-13','CL-12','BO-14','BO-12','BC-Q8','BC-D1','BC-77773','B33-35', 'B33-32','B03-13','B03-12','AX-32','AX-26','AX-24','AX-15','AX-13','AX-12','AW-32','AW-26','AW-24','AW-15','AW-13','AW-12','AU-32','AU-26','AU-24','AU-15','AU-13','AU-12','AT-34','AT-32','AT-26','AT-24','AT-15', 'AT-13','AT-12','AL-32','AL-26','AL-24','AL-15','AL-13','AL-12','AI-400','AI-355','ADU-215','AC-77771','AC-400','A61-774','A61-768','A61-767','A61-766','A60-774','A60-768','A60-767','A60-766','A53-774','A53-769', 'A53-768','A53-767','A53-766','A49-767','A49-766','A48-768','A48-767','A48-766','A47-774','A47-768','A47-767','A47-766','A46-776','A46-774','A46-768','A46-767','A46-766','A45-802','A45-774','A45-769','A45-768', 'A45-767','A45-766','A43-768','A43-767','A43-766','A42-774','A42-769','A42-768','A42-767','A42-766','A41-774','A41-769','A41-768','A41-767','A41-766','A40-774','A40-769','A40-768','A40-767','A40-766','A39-774', 'A39-768','A39-767','A39-766','A38-774','A38-768','A38-767','A38-766','A37-774','A37-769','A37-768','A37-767','A37-766','A36-774','A36-768','A36-767','A36-766','A35-768','A35-767','A35-766','A34-768','A34-767', 'A34-766','A33-774','A33-769','A33-768','A33-767','A33-766','A32-774','A32-769','A32-768','A32-767','A32-766','A31-774','A31-769','A31-768','A31-767','A31-766','A06-13','A06-12','80-20936','79-20936','78-20936', '77-20936','720-9','59-20936','500-5','463-20','460-17','413-10','411-30','411-27','411-25','411-24','411-17','411-16','411-12','4-10413','4-10412','398-1','396-5','396-3','396-1','395-6','283-3','281-2','280-3', '23-725','164-12','164-11','163-15','163-12','163-11','162-16','162-12','162-11','120-15','120-12','120-11','10024-3179','900754-3006') GROUP BY T1.RAMO_PROD,POLIZA,riesgo,t1.amparo,T3.DESCRIPCION,FI_CERTIFICADO,FF_CERTIFICADO, t2.SBU,documento,ANEXO,RECIBO,SMOVREC,tipo_transaccion,cod_transaccion) M ) P WHERE P.ult_doc = 1 ) SELECT a.*, b.DESC_COD_TRANSAC, C.DESC_MODALIDAD FROM asistencias_vigentes a left join liberty.APOYO.DWH_COD_TRANSAC b on (a.tipo_transaccion=b.TIPO_TRANSACand a.cod_transaccion=b.COD_TRANSAC) LEFT JOIN LIBERTY.APOYO.DWH_MODALIDADES C ON (ltrim(rtrim(A.RAMO_PROD))=ltrim(rtrim(C.RAMO_PROD)) AND A.COD_MODALIDAD=C.COD_MODALIDAD) where SBU IN ('" &amp; Join(Parameters!SBU.Value, "','") &amp; "') and a.sucursal_prod IN (" &amp; Join(Parameters!Sucursal.Value, ",") &amp; ") and a.RAMO_PROD IN ('" &amp; Join(Parameters!Ramos.Value, "','") &amp; "')"</CommandText>
      </Query>
