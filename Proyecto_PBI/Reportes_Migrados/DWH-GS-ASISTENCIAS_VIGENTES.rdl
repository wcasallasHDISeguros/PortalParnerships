    <DataSet Name="Sucursal">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>select distinct Sucursal from liberty.APOYO.DWH_REDCOMERCIAL_SUCURSAL</CommandText>
      </Query>
