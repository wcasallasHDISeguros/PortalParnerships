    <DataSet Name="PERIODOS">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT
    TO_CHAR(DATEADD(month, n, CURRENT_DATE), 'YYYYMM') AS PERIODO
FROM (
    SELECT -1 AS n
    UNION ALL SELECT 0
    UNION ALL SELECT 1
    UNION ALL SELECT 2
    UNION ALL SELECT 3
    UNION ALL SELECT 4
) meses
ORDER BY PERIODO</CommandText>
      </Query>
      <Fields>
        <Field Name="PERIODO_1">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PERIODO</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
