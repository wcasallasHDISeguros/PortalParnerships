	partition Calendar2-67fb0c3b-a5fe-4e6b-8555-81010e38b701 = calculated
		mode: import
		source = ```
				
					  ADDCOLUMNS(
					   CALENDAR(DATE(2023,10,1),TODAY())
					     ,"Year",YEAR([Date])
					     ,"MonthSort",(100*year([Date])+MONTH([Date]))
					     ,"Month Date",DATE(YEAR([Date]),MONTH([Date]),1)
					     ,"Month of Year",MONTH([Date])
					     ,"Month Year Name",FORMAT([Date],"MMM") & " " & YEAR([Date])
					     ,"Month Name",FORMAT([Date],"MMMM")
					     ,"Day of Month",DAY([Date])
					     ,"Day of Week",WEEKDAY([Date],1)
					     ,"Day Name",FORMAT([Date],"DDDD")
					     ,"Week of Year",WEEKNUM([Date],1)
					     ,"Week Date",(DATE(YEAR([Date]),MONTH([Date]),DAY([Date]))-(WEEKDAY([Date],1)-1))
					     ,"Week Name","Week of " & (DATE(YEAR([Date]),MONTH([Date]),DAY([Date]))-(WEEKDAY([Date],1)-1))
					     ,"Quarter Date",DATE(YEAR([Date]),SWITCH(ROUNDUP(DIVIDE(MONTH([Date]),3,1),0),1,1,2,4,3,7,4,10),1)
					     ,"Quarter Name","Q" & ROUNDUP(MONTH([Date])/3,0)
					     ,"Quarter Year Name","Q" & ROUNDUP(MONTH([Date])/3,0) & " " & YEAR([Date])
					     ,"Year Date", DATE(YEAR([Date]),1,1)
				    )
				```

