		sourceColumn: Notification Full Description

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Notification Order'
		dataType: double
		formatString: 0
		lineageTag: e3e2b6b0-8a19-4b97-998b-6be90c1a03eb
		summarizeBy: sum
