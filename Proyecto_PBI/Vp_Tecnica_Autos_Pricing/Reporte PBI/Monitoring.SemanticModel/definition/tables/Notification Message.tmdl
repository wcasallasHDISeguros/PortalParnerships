table 'Notification Message'
	lineageTag: 5f1c9128-fc11-4415-b508-5a47e63bfc2e

	/// Display Measure to show the notification header
	measure 'Notification Display' =
			
			UPPER (
			    IF (
			        SUM ( 'Notification Message'[Visibility] ) = 0,
			        "",
			        CALCULATE (
			            VALUES ( 'Notification Message'[Time Stamp] ),
			            'Notification Message'[Notification Order] = 1
			        ) & " | "
			            & CALCULATE (
			                VALUES ( 'Notification Message'[Notification Header] ),
			                'Notification Message'[Notification Order] = 1
			            )
			    )
			)
		lineageTag: 322ae95e-13d8-4a7b-8894-93f3ac91b335

	/// Display Measure to show full notification messages
	measure 'Full Details Display' =
			
			IF (
			    SUM ( 'Notification Message'[Visibility] ) = 0,
			    "All Systems Normal",
			    CALCULATE (
			        VALUES ( 'Notification Message'[Notification Full Description] ),
			        'Notification Message'[Notification Order] = 1
			    )
			)
		lineageTag: 98c07660-a766-42e8-a226-9080457b79f1

	column Visibility
		dataType: double
		isHidden
		formatString: 0
		lineageTag: 3448162f-82ef-4a4e-b6ef-1887965180a8
		summarizeBy: none
		sourceColumn: Visibility

		changedProperty = IsHidden

		annotation SummarizationSetBy = User

	column 'Time Stamp'
