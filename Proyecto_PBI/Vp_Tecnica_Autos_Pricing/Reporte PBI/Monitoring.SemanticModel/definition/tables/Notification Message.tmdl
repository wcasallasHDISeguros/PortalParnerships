	partition 'Notification Message-c4e9b63a-95ee-4da5-8846-ef9d7e5ef73b' = m
		mode: import
		queryGroup: 'DO NOT DELETE'
		source =
				let
				    Source = SharePoint.Files(#"Template Control SharePoint Root URL", [ApiVersion = 15]),
				    FileID = Source{[Name=#"Template Control File Name"&".xlsx"]}[Content],
				    #"Import Excel to display table and sheets" = Excel.Workbook(FileID),
				    #"Point to Notification Header table" = #"Import Excel to display table and sheets"{[Item="NotificationHeader",Kind="Table"]}[Data],
				    #"Sort result set by Time Stamp" = Table.Sort(#"Point to Notification Header table",{{"Time Stamp", Order.Descending}}),
				    #"Add Index as Notification order to break potential ties" = Table.AddIndexColumn(#"Sort result set by Time Stamp", "Notification Order", 1, 1)
				in
				    #"Add Index as Notification order to break potential ties"

