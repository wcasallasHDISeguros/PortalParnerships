	measure 'Poliza_Emitida MoM%' =
			
			VAR __PREV_MONTH =
				CALCULATE(
					SUM('Conversion Data'[emitidas]),
					DATEADD('Calendar2'[Date], -1, MONTH)
				)
			RETURN
				DIVIDE(
					SUM('Conversion Data'[emitidas]) - __PREV_MONTH,
					__PREV_MONTH
				)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d3444241-2330-497f-a67c-3824987d9bb6

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MonthOverMonth"
				}

		changedProperty = IsHidden

	measure 'Poliza_Emitida WoW%' =
			
			VAR __PREV_WEEK =
				CALCULATE(
					SUM('Conversion Data'[Poliza_Emitida]),
					DATEADD('Calendar2'[Date], -7, DAY)
				)
			RETURN
				DIVIDE(
					SUM('Conversion Data'[Poliza_Emitida]) - __PREV_WEEK,
					__PREV_WEEK
				)
		formatString: 0%;-0%;0%
		lineageTag: 4930814e-73ca-4925-8c17-54fed6391d27

		changedProperty = IsHidden

