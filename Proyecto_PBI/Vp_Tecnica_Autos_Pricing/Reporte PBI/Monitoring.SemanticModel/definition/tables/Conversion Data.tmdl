	column Modelo = LOOKUPVALUE('Pricing Versions Automated'[Modelo],'Pricing Versions Automated'[Rule-Version],'Conversion Data'[Rule-Version])
		lineageTag: 6597fc1e-3e1e-4f6b-9900-4dc9d29b1061
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Conversion Data","TableItemName":"NB Opt Category","ObjectType":4},"LinkType":"UsedInGroup"}]

	column 'Quote after 4/18/22' = IF(DATE(2022,4,18)<'Conversion Data'[Fecha_Cotizacion], "Yes", "No")
		lineageTag: f0c046c7-bfb9-4e7d-9ea2-964b5d325c36
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column NB_Opt_Category_New_2022 =
			
			IF('Conversion Data'[NB Opt VersionID?] = "Yes" && 'Conversion Data'[PrimaAnual<100k] = "No" && 'Conversion Data'[RanuniInd] = ">0.5" && 'Conversion Data'[Quote after 4/18/22] = "No", "Optimized Group", (
			IF('Conversion Data'[NB Opt VersionID?] = "Yes" && 'Conversion Data'[PrimaAnual<100k] = "No" && 'Conversion Data'[Quote after 4/18/22] = "Yes", "Optimized Group", (
			IF('Conversion Data'[Price Opt RuleID?] = "Yes" && 'Conversion Data'[Modelo] = "Unrestricted Model" && 'Conversion Data'[Quote after 4/18/22] = "No", "Control Group", (
			IF('Conversion Data'[Price Opt RuleID?] = "Yes" && 'Conversion Data'[Modelo] = "New Unrestricted Model" && 'Conversion Data'[Quote after 4/18/22] = "Yes", "Control Group","N/A" )
			))))))
		lineageTag: 3e8418de-0440-47d6-90d2-e705fe18d61e
		summarizeBy: none

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Sum Insured Value Range' =
			
			VAR va = 'Conversion Data'[valorAseguradoVehi]
			RETURN
			SWITCH(TRUE(),
			        va <= 30000000,"<30000000",
			        va <= 50000000,"30000000 - 50000000",
			        va <= 80000000,"50000000 - 80000000",
			        va <= 100000000,"80000000 - 100000000",
			        va <= 200000000,"100000000 - 200000000",
			        va > 200000000,">200000000",
			        BLANK ()
			)
		lineageTag: 826c0b44-a634-4636-bd87-c1cae46636f8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Last 12 Months' = IF(and('Conversion Data'[Fecha_Cotizacion] > EDATE([Indicator date], -12),'Conversion Data'[Fecha_Cotizacion] <= EDATE([Indicator date],0)),1, 0)
		formatString: 0
		lineageTag: 10d9380f-862e-4a2b-99dc-8fad8a4a53f7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Last 6 Months' = IF(and('Conversion Data'[Fecha_Cotizacion] > EDATE([Indicator date], -6),'Conversion Data'[Fecha_Cotizacion] <= EDATE([Indicator date],0)),1, 0)
		formatString: 0
		lineageTag: 33a20518-aaa0-4c4d-a612-ff23a95bb52e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Last 3 Months' = IF(and('Conversion Data'[Fecha_Cotizacion] > EDATE([Indicator date], -3),'Conversion Data'[Fecha_Cotizacion] <= EDATE([Indicator date],0)),1, 0)
		formatString: 0
		lineageTag: bb984710-73ff-4071-9c27-84dd5032ef48
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Last Month' = IF(and('Conversion Data'[Fecha_Cotizacion] > EDATE([Indicator date], -1),'Conversion Data'[Fecha_Cotizacion] <= EDATE([Indicator date],0)),1, 0)
		formatString: 0
		lineageTag: 4c8a8bfb-7a6d-4a77-b9d2-a335e60fae3e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

