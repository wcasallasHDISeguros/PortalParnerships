	column Bind_1month+ = IF(ISBLANK('Conversion Data'[Fecha_Emision]), BLANK(),if(DATEDIFF('Conversion Data'[Fecha_Cotizacion], 'Conversion Data'[Fecha_Emision], DAY)>30, "True", "False"))
		lineageTag: 92008402-1c7c-485e-adc9-88eea5cf7976
		summarizeBy: none

