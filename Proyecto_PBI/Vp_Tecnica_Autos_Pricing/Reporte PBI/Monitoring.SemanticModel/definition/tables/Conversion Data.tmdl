	column Bind_2week+ = IF(ISBLANK('Conversion Data'[Fecha_Emision]), BLANK(),if(DATEDIFF('Conversion Data'[Fecha_Cotizacion], 'Conversion Data'[Fecha_Emision], DAY)>14, "True", "False"))
		lineageTag: 9dbc5cde-6d60-4ea8-b24e-7ab29af7783b
