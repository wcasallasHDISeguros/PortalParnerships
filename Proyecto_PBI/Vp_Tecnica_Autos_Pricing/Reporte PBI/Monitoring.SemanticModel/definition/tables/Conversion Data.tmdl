	measure Elasticity = ```
			
			    var pricetest_neg = 0.95
			    var pricetest_pos = 1.05
			    var conversion_neg = CALCULATE('Conversion Data'[Conversion], 'Conversion Data'[PriceTest] = 0.95)
			    var conversion_pos = CALCULATE('Conversion Data'[Conversion], 'Conversion Data'[PriceTest] = 1.05)
			    RETURN 
			        DIVIDE(
			            LN(DIVIDE(conversion_pos, conversion_neg)),
			            LN(DIVIDE(pricetest_pos, pricetest_neg))) * -1
			```
		formatString: 0.00
		lineageTag: 7bfa7d21-781f-4a1e-a1de-745823dbb17a

		changedProperty = IsHidden

	measure 'Simple linear regression' =
			
			VAR Known =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ('Conversion Data'[PriceTest]),
			            "Known[X]", 'Conversion Data'[PriceTest],
			            "Known[Y]", [Conversion]
			        ),
			        AND (
			            NOT ( ISBLANK ( Known[X] ) ),
			            NOT ( ISBLANK ( Known[Y] ) )
			        )
			    )
			VAR Count_Items =
			    COUNTROWS ( Known )
			VAR Sum_X =
			    SUMX ( Known, Known[X] )
			VAR Sum_X2 =
			    SUMX ( Known, Known[X] ^ 2 )
			VAR Sum_Y =
			    SUMX ( Known, Known[Y] )
			VAR Sum_XY =
			    SUMX ( Known, Known[X] * Known[Y] )
			VAR Average_X =
			    AVERAGEX ( Known, Known[X] )
			VAR Average_Y =
			    AVERAGEX ( Known, Known[Y] )
			VAR Slope =
			    DIVIDE (
			        Count_Items * Sum_XY - Sum_X * Sum_Y,
			        Count_Items * Sum_X2 - Sum_X ^ 2
			    )
			VAR Intercept =
			    Average_Y - Slope * Average_X
			RETURN
			    AVERAGEX(DISTINCT('Conversion Data'[PriceTest]), Intercept + Slope * 'Conversion Data'[PriceTest])
		lineageTag: ac99ca3c-cbc1-4993-8082-94857adb6173

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

