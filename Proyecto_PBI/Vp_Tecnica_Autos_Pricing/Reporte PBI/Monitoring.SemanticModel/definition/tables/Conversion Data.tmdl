	column 'NB_Opt_Category NEW' =
			SWITCH(
			    TRUE(),
			    'Conversion Data'[NB_Opt_Category]="Control","Control",
			    'Conversion Data'[NB_Opt_Category]="Optimized", "Optimized",
			    AND('Conversion Data'[NB_Opt_Category]="Not Optimized", 'Conversion Data'[NB Opt Rest]=1), "Not Optimized (Restricted Model)",
			    AND('Conversion Data'[NB_Opt_Category]="Not Optimized", 'Conversion Data'[NB Opt Rest]=0), "Not Optimized (Unrestricted Model)"
