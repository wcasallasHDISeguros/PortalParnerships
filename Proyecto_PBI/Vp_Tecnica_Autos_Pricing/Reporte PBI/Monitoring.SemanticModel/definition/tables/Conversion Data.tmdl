	measure 'Elasticity +-10%' = ```
			
			    var pricetest_neg = 0.9
			    var pricetest_pos = 1.1
			    var conversion_neg = CALCULATE('Conversion Data'[Conversion], 'Conversion Data'[PriceTest] = 0.9)
			    var conversion_pos = CALCULATE('Conversion Data'[Conversion], 'Conversion Data'[PriceTest] = 1.1)
			    RETURN 
			        DIVIDE(
			            LN(DIVIDE(conversion_pos, conversion_neg)),
			            LN(DIVIDE(pricetest_pos, pricetest_neg))) * -1
			```
		formatString: 0.00
		lineageTag: 84deb93b-d468-4954-98a7-33845da12967

	measure 'Elasticity (Price Decrease 0.90)' = ```
			
			    var pricetest_neg = 0.9
			    var conversion_neutral = CALCULATE('Conversion Data'[Conversion], 'Conversion Data'[PriceTest] = 1)
			    var conversion_neg = CALCULATE('Conversion Data'[Conversion], 'Conversion Data'[PriceTest] = 0.9)
			    RETURN 
			        DIVIDE(
			            LN(DIVIDE(conversion_neg, conversion_neutral)),
			            LN(pricetest_neg)) * -1
			```
		formatString: 0.00
		lineageTag: d4f2d7db-6db9-4440-a5f2-aecb746426b4

	measure 'Elasticity (Price Increase 1.10)' = ```
			
			    var pricetest_pos = 1.1
			    var conversion_neutral = CALCULATE('Conversion Data'[Conversion], 'Conversion Data'[PriceTest] = 1)
			    var conversion_pos = CALCULATE('Conversion Data'[Conversion], 'Conversion Data'[PriceTest] = 1.1)
			    RETURN 
			        DIVIDE(
			            LN(DIVIDE(conversion_pos, conversion_neutral)),
			            LN(pricetest_pos)) * -1
			```
		formatString: 0.00
		lineageTag: a8448721-0b27-421b-97a5-e72e8b33a381

