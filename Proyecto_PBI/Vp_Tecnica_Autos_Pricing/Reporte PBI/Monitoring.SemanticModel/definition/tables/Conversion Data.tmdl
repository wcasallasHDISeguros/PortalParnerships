	column 'numeromultas (groups)' =
			SWITCH(
				TRUE,
				ISBLANK('Conversion Data'[numeromultas]),
				"(Blank)",
				'Conversion Data'[numeromultas] IN {-3},
				"Liberty's service failure",
				'Conversion Data'[numeromultas] IN {0,
