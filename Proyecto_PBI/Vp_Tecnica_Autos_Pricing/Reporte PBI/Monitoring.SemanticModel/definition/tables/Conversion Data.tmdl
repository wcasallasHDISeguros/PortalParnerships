	column 'ValorAsegu Monitoreo' =
			
			VAR va = 'Conversion Data'[valorAseguradoVehi]
			RETURN
			SWITCH(TRUE(),
			        va <= 30000000,30000000,
			        va <= 60000000,60000000,
			        va <= 90000000,90000000,
			        va <= 120000000,120000000,
