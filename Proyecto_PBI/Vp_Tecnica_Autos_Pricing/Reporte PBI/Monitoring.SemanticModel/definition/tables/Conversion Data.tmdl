	measure Medida
		lineageTag: d2d270ce-be82-4918-9abf-b5c2b6d4108a

		annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":null}

		annotation 277cc1b9-af89-4597-8e15-cacc25c0886b = Para usar caracteres especiales en un nombre de medida, incluya el nombre completo entre corchetes ([]) y agregue un ] a cualquier corchete de cierre en el nombre.

	measure 'MLR Emitido sin asistencias ni salvamentos' =
			
			VAR AnioModelo = SELECTEDVALUE('Conversion Data'[AñoModelo])
			RETURN
			IF(
			    AnioModelo >= 2026,
			    [MLR Emitido] * 0.9,
			    [MLR Emitido] * 0.95
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 8961e577-af46-4510-8959-b0357167927e

	measure 'MLR Emitido2' = CALCULATE(([NetActuarialCostParameter Sum]/[Prima Sum] ),'Conversion Data'[emitidas]=1)
		lineageTag: 5da1e89f-f4a2-462f-89cd-fe2a14e113ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'NetActuarialCostParameter Sum' = SUMX(DISTINCT('Conversion Data'[LLAVE_PFDI]),CALCULATE(AVERAGE('Conversion Data'[netactuarialcostparameter])))
		lineageTag: be79cd35-6c3d-46d9-91ec-45b453844d42

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net MLR Emitido' = CALCULATE(([NetActuarialCostParameter Sum]/[Prima Sum] ),'Conversion Data'[emitidas]=1)
		lineageTag: 58f325ef-9b2f-4ba5-b452-c1cb2a9ddd97

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MLR Emitido sin asistencias ni salvamentos2' =
			
			VAR AnioModelo = SELECTEDVALUE('Conversion Data'[AñoModelo])
			RETURN
			IF(
			    AnioModelo >= 2026,
			    [MLR Emitido2] * 1,
			    [MLR Emitido] * 1
			)
		lineageTag: 008278de-3105-459d-8e86-55ef5f9ff2ee

		annotation PBI_FormatHint = {"isGeneralNumber":true}

