	column 'Days to Bind' = IF(NOT(ISBLANK('Conversion Data'[Fecha_Emision])), DATEDIFF('Conversion Data'[Fecha_Cotizacion],'Conversion Data'[Fecha_Emision],DAY),BLANK())
		formatString: 0
		lineageTag: c1bd9608-4a28-4609-8eb5-9d0496c52914
		summarizeBy: sum

