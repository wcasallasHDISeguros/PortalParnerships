	column Bind_1week+ = IF(ISBLANK('Conversion Data'[Fecha_Emision]), BLANK(),if(DATEDIFF('Conversion Data'[Fecha_Cotizacion], 'Conversion Data'[Fecha_Emision], DAY)>7, "True", "False"))
