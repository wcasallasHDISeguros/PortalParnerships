	measure 'AWP % difference' =
			
			VAR __BASELINE_VALUE = CALCULATE([AWP], 'Pricing Versions Automated'[Modelo] = "New Unrestricted Model")
			VAR __VALUE_TO_COMPARE = CALCULATE([AWP], 'Pricing Versions Automated'[Modelo] = "Optimized")
			RETURN
				IF(
					NOT ISBLANK(__VALUE_TO_COMPARE),
					DIVIDE(__VALUE_TO_COMPARE - __BASELINE_VALUE, __BASELINE_VALUE)
				)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e6ff274a-b820-4f42-8986-b21864a55af3

		changedProperty = IsHidden

