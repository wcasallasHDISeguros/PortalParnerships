	measure 'Captured Premium (COP)v1' =
			
			VAR v84PremSub700k = CALCULATE([Prima_v84 Sum],'Conversion Data'[versionId] = 22114771, 'Conversion Data'[Prima_v84] < 700000)
			VAR Prem_v84Conversion = v84PremSub700k * (CALCULATE('Conversion Data'[Conversion], 'Conversion Data'[versionId] = 22114771, 'Conversion Data'[Prima_v84] < 700000))
			VAR Prem_v85Conversion = v84PremSub700k * (CALCULATE('Conversion Data'[Conversion], 'Conversion Data'[versionId] = 22115064, 'Conversion Data'[Prima_v85] < 700002))
			RETURN Prem_v85Conversion - Prem_v84Conversion
		formatString: \$\ #,0;-\$\ #,0;\$\ #,0
		lineageTag: 24ef562b-5d9a-4f48-8c7a-44c02ab86f42

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"currencyCulture":"es-CO"}

