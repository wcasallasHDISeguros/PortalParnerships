	measure 'Conversion % difference from Conversion' =
			
			VAR __BASELINE_VALUE = CALCULATE([Conversion], 'Pricing Versions Automated'[Modelo] = "New Unrestricted Model")
			VAR __VALUE_TO_COMPARE = CALCULATE([Conversion], 'Pricing Versions Automated'[Modelo] = "Optimized")
			RETURN
				IF(
					NOT ISBLANK(__VALUE_TO_COMPARE),
					DIVIDE(__VALUE_TO_COMPARE - __BASELINE_VALUE, __BASELINE_VALUE)
				)
		formatString: 0%;-0%;0%
