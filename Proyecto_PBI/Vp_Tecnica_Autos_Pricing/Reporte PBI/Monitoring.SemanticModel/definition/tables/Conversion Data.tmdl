	measure 'AQP % Diff' = DIVIDE(CALCULATE([AQP], 'Pricing Versions Automated'[Modelo] = "New Unrestricted Model") - CALCULATE([AQP], 'Pricing Versions Automated'[Modelo] = "Unrestricted Model") ,[AQP])
