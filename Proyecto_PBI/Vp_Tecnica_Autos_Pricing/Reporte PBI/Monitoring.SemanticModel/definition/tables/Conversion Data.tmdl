			        CALCULATE(
			            AVERAGEX('Conversion Data',
			            DIVIDE(SUM('Conversion Data'[EMITIDA]),SUM('Conversion Data'[Conteo_Cotizacion]))),
			            DATESINPERIOD('Conversion Data'[Fecha_Cotizacion], start_date, date_window, DAY),
