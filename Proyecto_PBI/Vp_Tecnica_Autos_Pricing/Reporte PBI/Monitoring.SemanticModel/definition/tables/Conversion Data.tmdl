	column AñoModelo =
			
			VAR Modelo =
			    LOOKUPVALUE(
			        'Pricing Versions Automated'[Modelo],
			        'Pricing Versions Automated'[Rule-Version],
			        'Conversion Data'[Rule-Version]
			    )
			VAR YearFound =
			    MAXX(
			        {
			            FIND("20", Modelo, 1, BLANK())
			        },
			        VAR pos = [Value]
			        RETURN
			            IF(
			                NOT ISBLANK(pos),
			                INT(VALUE(MID(Modelo, pos, 4)))
			            )
			    )
			RETURN
			IF(
			    YearFound >= 2000 && YearFound <= 2100,
			    YearFound,
			    BLANK()
			)
		lineageTag: 58de8316-2dd2-4566-ba15-ce644a8098bb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'MLR Emitido-sin asistencias ni salvamentos' = IF('Conversion Data'[AñoModelo]=2026,[MLR Emitido]*0.9,[MLR Emitido]*0.95)
