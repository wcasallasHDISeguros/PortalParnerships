	measure 'AQP Unrest/Rest' = ```
			
			
			VAR AQP_Model1 = 'Conversion Data'[AQP Unrestricted]
			VAR AQP_Model2 = [AQP Restricted]
			VAR Quote_Model1 = [Quote Count (Unrestricted)]
			VAR Quote_Model2 = [Quote Count (Optimized)]
			VAR DIFF = ABS(DIVIDE(AQP_Model1, AQP_Model2, 1) - 1)
			
			RETURN 
			
			    IF(
			    OR(
			        Quote_Model1 < [Quote Threshold], Quote_Model2 < [Quote Threshold]), 
			        "Low Quote", 
