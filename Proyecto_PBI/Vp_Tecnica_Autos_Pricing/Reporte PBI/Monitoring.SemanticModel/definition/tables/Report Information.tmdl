	partition 'Report Information-2a7a6cf3-07b4-4cf6-b451-4064f8bb4e17' = m
		mode: import
		queryGroup: 'DO NOT DELETE'
		source =
				let
				    Source = SharePoint.Files(#"Template Control SharePoint Root URL", [ApiVersion = 15]),
				    FileID = Source{[Name=#"Template Control File Name"&".xlsx"]}[Content],
				    #"Import Excel to display table and sheets" = Excel.Workbook(FileID),
				    #"Point to Notification Header table" = #"Import Excel to display table and sheets"{[Item="ReportInformation",Kind="Table"]}[Data],
				    #"Append ""Mailto:"" to Contact Email for clickable URL" = Table.AddColumn(#"Point to Notification Header table", "Contact Email URL", each "mailto:"&[Contact Email])
				in
				    #"Append ""Mailto:"" to Contact Email for clickable URL"

