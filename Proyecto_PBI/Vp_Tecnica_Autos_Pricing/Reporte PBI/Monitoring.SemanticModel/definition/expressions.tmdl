expression 'Sample File' =
		let
		    Source = SharePoint.Files("https://libertymutual.sharepoint.com/sites/AndesPricingMotorTeam", [ApiVersion = 15]),
		    #"Filtered Rows" = Table.SelectRows(Source, each ([Name] = "Pricing versions.xlsx")),
		    Navigation1 = #"Filtered Rows"{0}[Content]
		in
		    Navigation1
	lineageTag: 6058fc3b-ecda-4538-8282-591918091a11
