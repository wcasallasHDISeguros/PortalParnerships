    <DataSet Name="PERIODOS">
      <Query>
        <DataSourceName>DWH</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>declare

@fec_inicio Date,

@fec_fin Date

select @fec_inicio = DATEADD(month, -1, GETDATE()), @fec_fin = DATEADD(month, 4, GETDATE())

;WITH FECHAS(fecha) AS (

SELECT @fec_inicio fecha

UNION ALL

SELECT DATEADD(month, 1, fecha) fecha

FROM FECHAS

WHERE fecha &lt; @fec_fin

)


select distinct  left(CONVERT(varchar,fecha,112),6) as PERIODO from FECHAS</CommandText>
      </Query>
      <Fields>
        <Field Name="PERIODO_1">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>PERIODO</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
