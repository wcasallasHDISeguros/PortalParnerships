    <DataSource Name="dwh">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=wdbanal-dwhp01.hdicolombia.com.co;Initial Catalog=Liberty</ConnectString>
