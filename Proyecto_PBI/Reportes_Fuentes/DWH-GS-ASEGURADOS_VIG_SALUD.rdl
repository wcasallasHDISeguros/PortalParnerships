  <DataSets>
    <DataSet Name="Casos">
      <Query>
        <DataSourceName>dwh</DataSourceName>
        <CommandText>/*********************
ASEGURADOS VIGENTES
**********************/

drop table   if exists  #asegurados
SELECT P.*
INTO #asegurados
FROM(
select  M.*,ROW_NUMBER  ()over (partition by M.LLAVE_CERT,[TIPO_IDENTIFI_ASEG],[NRO_IDENTIFI_ASEG] order by M.LLAVE_CERT, M.[DOCUMENTO] desc , M.anexo desc , M.recibo desc, M.SMOVREC desc ) as ult_doc 
from (
SELECT distinct 
	   (CONCAT(ltrim(rtrim(RAMO_PROD)),'_',POLIZA,'_',certificado)) AS LLAVE_CERT
      ,[RAMO_PROD]
      ,[POLIZA]
      ,[CERTIFICADO]
      ,[DOCUMENTO]
      ,[ANEXO]
	  ,[nro_unico_aseg]
      ,[TIPO_IDENTIFI_ASEG]
      ,[NRO_IDENTIFI_ASEG]
      ,[IND_ASEG_PPAL]
      ,[TIPO_ROL]
      ,[FI_VIG_ASEG]
      ,[FF_VIG_ASEG]
      ,[TIPO_PERSONA]
      ,[FECHA_NACIMIENTO]
      ,genero
      ,CASE WHEN [COD_DEPARTAMENTO] = 'NA' THEN 0 ELSE COD_DEPARTAMENTO END AS COD_DEPARTAMENTO
      ,CASE WHEN [COD_CIUDAD] = 'N/A' THEN 0 ELSE [COD_CIUDAD] END AS [COD_CIUDAD] 
	  ,case when RECIBO is null then  0
	else RECIBO end as RECIBO,
	case
	when  [SMOVREC] is null then  0
	else [SMOVREC] end as SMOVREC

 FROM [Liberty].[PROD].[DWH_POL_ASEG_H] 
  left join [Liberty_Pruebas_Actuaria].[dbo].clientes_inclusion_2023_genero on (tipo_id=[TIPO_IDENTIFI_ASEG]  and numero_id=[NRO_IDENTIFI_ASEG])
  WHERE FI_VIG_ASEG&lt;= 20250831 and FF_VIG_ASEG &gt;= 20250831 and 
 --RAMO_PROD in  ('10001','10003','462','6026','6031','6033','6036','6038','6039','6046','6060','6061','7467','7468','7469','900719','900720','900753','900758','800004')
 ramo_prod in ('ADU','Z1','E1','T1','SE','H1')  
 )m )P where p.ult_doc = 1

/******************************
NOMBRES TOMADOR Y ASEGURADO
*******************************/
 SELECT a.*,b.NRO_DOCUMENTO_TOMADOR,b.NOMBRE_TOMADOR,c.NOMBRE_CLIENTE AS NOMBRE_ASEGURADO,Nom_Dep,Nom_Ciu FROM #asegurados a
 left join liberty.[APOYO].[DWH_TOMADORES] b on a.RAMO_PROD =b.COD_RAMO_PROD and a.POLIZA = b.NRO_POLIZA
 left join liberty.[CLIENTE].[CLIENTE_UNIFICADO] c on a.tipo_identifi_Aseg = c.tipo_identifi_clie  and nro_identifi_Aseg=c.nro_identifi_clie
 left join [Liberty_Pruebas_Actuaria].dbo.[DANE_Dep_Ciu_GD] d on a.COD_DEPARTAMENTO = convert(int,d.Cod_Dep) AND a.COD_CIUDAD = convert(int,d.Cod_Ciu)</CommandText>
      </Query>
